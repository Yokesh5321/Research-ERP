# ============================================================
# Research ERP — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================

# ============================================================
# FRONTEND VARIABLES (VITE_ prefix — accessible in React code)
# ============================================================

# Your Supabase project URL (from: Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/publishable key (safe to expose in frontend)
# (from: Supabase Dashboard → Project Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Your deployed backend URL (from Render / Railway / Fly.io)
# In development: leave empty so Vite proxy handles /api → localhost:5000
# In production: set to your actual backend URL (no trailing slash)
# Example: VITE_API_URL=https://research-erp-backend.onrender.com
VITE_API_URL=

# ============================================================
# BACKEND VARIABLES (Node.js/Express — server-side only)
# ============================================================

# Your Supabase project URL (same as VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# !! SECRET !! Your Supabase service_role key — NEVER expose this in frontend!
# (from: Supabase Dashboard → Project Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Your deployed frontend URL (for CORS — no trailing slash)
# Example: FRONTEND_URL=https://research-erp.vercel.app
FRONTEND_URL=https://your-frontend-domain.com

# GitHub webhook secret — set this in your GitHub repo webhook settings
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Server port (hosting platforms set this automatically — do not hardcode)
PORT=5000

# ============================================================
# DEVELOPMENT NOTES
# ============================================================
# Local development:
#   1. Run backend:  npm run server:dev   → http://localhost:5000
#   2. Run frontend: npm run dev          → http://localhost:5173
#   3. Vite proxy routes /api → localhost:5000 automatically
#   4. Leave VITE_API_URL empty for local dev
#
# Production:
#   Frontend (Vercel/Netlify): set VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_API_URL
#   Backend (Render/Railway):  set SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, FRONTEND_URL, GITHUB_WEBHOOK_SECRET
